h1 {
  font-style : bold;
  font-family : Arial;
  font-weight : bold;
  text-align : center;
  color : #c0c0ff;
}
h2 {
  font-style : bold;
  font-family : Arial;
  font-weight : bold;
  text-align : center;
  color : #0000ff;
}
h3 {
    width: 100%;
    font-size: 1.4em;
    font-weight: bold;
    color: #ffffff;
    background-color: #0000ff;
    border-top: 2px solid #aaaaff;
    border-left: 2px solid #aaaaff;
    border-right: 2px solid #000088;
    border-bottom: 2px solid #000088;
    padding: 4px 0px 2px 1em;
}
h4 {
    heitht: 150%;
    font-weight: bold;
    font-size: 1.4em;
    margin-top: 2em;
    margin-bottom: 0em;
    padding-left: 1em;
}
h5 {
    font-weight: bold;
    font-size: 1em;
    margin-top: 1.5em;
    margin-bottom: 0em;
    padding-left: 2em;
}
p {
    margin-left: 3em;
}
ul, ol {
    margin-left: 3em;
}
ol ul {
    margin-left: 0em;
}
ul ol {
    margin-left: 0em;
}
ol ol {
    margin-left: 0em;
}
ul ul {
    margin-left: 0em;
}
li {
    padding-top: 0.2em;
    padding-bottom: 0.2em;
}
dl {
    margin-left: 3em;
}
table {
    margin-left: 5em;
    border-collapse: collapse;
    border: 2px solid black;
}
.noborder {
    border: 0px;
}
.nomargin{
	margin: 0em;
}
th {
    padding-left: 5px;
    padding-right: 5px;
    border: 1px solid #000;
}
td {
    padding-left: 5px;
    padding-right: 5px;
    border: 1px solid black;
}
td.fieldname {
    font-weight: bold;
    background-color: #cccccc;
}
